[Unit]
Description=Remote Screen persistent Wi-Fi Direct session
After=NetworkManager.service wpa_supplicant.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/remote-screen-p2p-helper
StandardInput=socket
StandardOutput=journal
StandardError=journal
RuntimeDirectory=remote-screen-p2p
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=remote-screen
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/run/remote-screen-p2p /var/lib/remote-screen
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
TimeoutStopSec=30
